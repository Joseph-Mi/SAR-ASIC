# PDK selection for this design. Sourced inside the container at shell start.
#
# This file is the source of truth. $DESIGNS/.designinit is a one-line shim
# that sources it -- see `make designinit`. That indirection exists because the
# container sources exactly one fixed path, outside any repo; putting the
# content here keeps it version-controlled, reviewable, and visible to anyone
# who clones, instead of living only on one machine.
#
# Every line is load-bearing. The image defaults to PDK=ihp-sg13g2 and derives
# the other four variables from PDK *before* this file is sourced, so setting
# PDK alone would leave them pointing into the IHP tree. Without all five,
# magic, ngspice, and KLayout load the wrong technology and produce wrong
# results with no error.
#
# Sourced by every shell in the container: keep it POSIX sh, and keep it from
# failing. A syntax error here breaks every terminal.

export PDK=sky130A
export PDKPATH=$PDK_ROOT/$PDK
export STD_CELL_LIBRARY=sky130_fd_sc_hd
export SPICE_USERINIT_DIR=$PDKPATH/libs.tech/ngspice

# Three entries, matching the image's own default layout. Dropping the `tech`
# entry hides sky130A.lyt and KLayout loads no technology at all; dropping the
# first discards the user's own KLayout settings.
export KLAYOUT_PATH=/headless/.klayout:$PDKPATH/libs.tech/klayout:$PDKPATH/libs.tech/klayout/tech
