# Single source of truth for NATIVE tool versions.
#
# Deliberately both valid Make syntax and valid shell syntax: the Makefile
# `include`s this file, and CI appends it to $GITHUB_ENV. No spaces around '=',
# no quotes, no values containing spaces -- that is what keeps both readers happy.
#
# Python package versions are NOT here. requirements.txt owns those, and pip
# enforces them at install time. Duplicating them would create two numbers that
# silently diverge.
#
# Verify with: make check-tools

# The three native pins are NOT chosen freely -- they are whatever
# OSIC_TOOLS_TAG's image ships, read off `make tool-versions` and recorded here
# so CI can install the same thing. Bumping the image is what changes them.
# `make check-tools` fails if they drift; `make tool-manifest` records the full
# inventory, including the tools this file does not pin.

VERILATOR_VERSION=5.050
YOSYS_VERSION=0.67
VERIBLE_VERSION=v0.0-4084-gf3e4d98b
OSIC_TOOLS_TAG=2026.07
